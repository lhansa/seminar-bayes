{
  "name": "seminar-bayes",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "containerEnv": {
    "QUARTO_PYTHON": "${containerWorkspaceFolder}/.venv/bin/python"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4200],
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
